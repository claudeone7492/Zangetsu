<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Phone MAIN+LAUNCHER lives on MainActivity in the main manifest so the
         Flutter tool can resolve a launch activity from the source manifest
         (it only scans <activity>, never <activity-alias>). The merged APK,
         though, must not carry it: leaving it in gives the launcher a second
         entry beside the enabled activity-alias, i.e. two icons. Release
         already strips it (src/release/AndroidManifest.xml); debug and profile
         do the same here so an installed debug build shows one icon too.
         `flutter run` launches the resolved component by name, so dropping the
         filter from the APK does not affect it. -->
    <application>
        <activity android:name=".MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
