<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network: Flutter only auto-adds INTERNET to debug builds, so it MUST be
         declared here or release builds have no network at all (streaming,
         providers, downloads). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Requested only when the user starts custom phone voice search. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Download progress notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Daily picks: flutter_local_notifications reschedules the three daily
         alarms after a reboot or an app update, which needs to hear about both. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- In-app update: install the downloaded APK via the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Foreground service so HLS downloads continue in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Foreground media-playback service: keeps the phone player's audio
         running while the app is backgrounded or in picture-in-picture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Bandwidth sharing (peer SDK). The SDK is vendored as source, so the
         permissions its AAR used to merge are declared here: the service holds a
         partial wakelock while sharing, and the relay handshake reads carrier and
         Wi-Fi state to pick a region. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <!-- The sharing service is `specialUse`, not `dataSync`: Android 15 forbids
         starting a dataSync service from BOOT_COMPLETED and caps one at 6h per
         24h, which between them make an always-on sharing service impossible. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Asked for at opt-in so sharing can restart after a reboot without the
         user opening the app. Never requested automatically. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Saving player screenshots to the gallery (gal); Android 10+ needs none. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <!-- Android TV leanback: required=false so the app still installs on phones. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- enableOnBackInvokedCallback stays FALSE. Turning on Android's predictive
         back gesture froze the UI when swiping back on some GPUs (confirmed on a
         MediaTek Helio G100 / Mali-G57) under Impeller — the gesture's route-
         snapshot render hangs there. We don't draw the predictive peek anyway
         (no PredictiveBackPageTransitionsBuilder), so this just uses the legacy
         back gesture, which works everywhere. Re-enabling needs both the theme
         transition builder AND a re-test on that device. -->
    <!-- android:icon below is the brand mark, NOT whichever launcher icon is
         selected. That one value is what the system shows in the installer,
         Settings → Apps, notifications, recents and share sheets, and it cannot
         follow the user's pick: Android resolves it at install time, while the
         <activity-alias> icons further down only ever affect the home screen.
         So it names the current mark and stays there — someone who picks Katana
         or Classic changes their home screen, not this. -->
    <application
        android:label="Zangetsu"
        android:extractNativeLibs="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher_crescent"
        android:banner="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="false"
        android:supportsRtl="true">
        <!-- flutter_background_service declares this service but without a
             foregroundServiceType, which Android 14+ requires for dataSync.
             Same attrs as the plugin + the type (merged, no conflict). -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:enabled="true"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />
        <!-- Keeps the process alive for native torrent downloads (phase 2). -->
        <service
            android:name=".TorrentDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter's `flutter run` / IDE launch parses THIS file (not the
                 merged APK) and requires an <activity> with MAIN + LAUNCHER. It
                 ignores <activity-alias>, so putting the phone launcher only on
                 the aliases below makes the tool fail with "package identifier
                 or launch activity not found" whenever no built APK is sitting
                 in build/ yet (first run, after clean, Cursor/VS Code debug).

                 The aliases remain the real home-screen entries (Settings →
                 Appearance flips them). src/release/AndroidManifest.xml strips
                 this filter so a shipped APK does not grow a second icon.

                 LEANBACK stays on the activity itself. TV has no icon picker and
                 uses android:banner, and moving this would risk the app losing
                 its home entry on a TV entirely. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Tracker OAuth redirects (AniList / MyAnimeList / Simkl) sent back
                 to zangetsu://<host> and captured by app_links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="zangetsu" android:host="anilist-auth"/>
                <data android:scheme="zangetsu" android:host="mal-auth"/>
                <data android:scheme="zangetsu" android:host="simkl-auth"/>
                <data android:scheme="zangetsu" android:host="mangabaka-auth"/>
                <!-- Shared-title deep link: zangetsu://open?d=…&t=… (see OpenLinkService). -->
                <data android:scheme="zangetsu" android:host="open"/>
                <data android:scheme="zangetsu" android:host="room"/>
                <!-- TV pairing QR: zangetsu://pair?code=… (see OpenLinkService). -->
                <data android:scheme="zangetsu" android:host="pair"/>
                <!-- Payment return page hand-off: zangetsu://payment/return?…
                     Just brings the app forward; entitlement is read from the
                     server, so no route payload is trusted. -->
                <data android:scheme="zangetsu" android:host="payment"/>
            </intent-filter>
            <!-- Keep the hostless Discord callback separate from tracker hosts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="discord-1518610045422665748"/>
            </intent-filter>
            <!-- "Open with" for local video files, so a file manager / Downloads
                 offers Zangetsu the way it offers any other player.

                 Deliberately NOT http/https: claiming those would put Zangetsu
                 in the chooser for every video link on the web, which is the
                 fast way to make the app feel like spyware. file:// and
                 content:// only — something the user already has on the device.

                 Separate <intent-filter> from the zangetsu:// block above on
                 purpose: within one filter Android ORs the schemes with the
                 mime types, so merging them would also claim zangetsu://*
                 video/* and, worse, every file:// host for the tracker hosts. -->
            <intent-filter android:label="Zangetsu">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="application/x-mpegURL"/>
                <data android:mimeType="application/vnd.apple.mpegurl"/>
            </intent-filter>
        </activity>

        <!-- Home-screen icon choices. Each alias is the same MainActivity behind a
             different icon; exactly ONE is ever enabled, and AppIconService flips
             them via PackageManager.setComponentEnabledSetting.

             Aliases (rather than swapping a drawable) are the only way Android
             allows this: the launcher icon is baked into the manifest at install
             time and cannot be changed at runtime.

             Renaming or removing an alias orphans it on users' home screens, so
             these names are permanent once shipped. -->
        <activity-alias
            android:name=".MainActivityCrescent"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_crescent"
            android:label="Zangetsu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher"
            android:label="Zangetsu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityClassic"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_classic"
            android:label="Zangetsu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Hosts a CloudStream plugin's own settings UI (it casts the Context to
             AppCompatActivity and shows a BottomSheetDialogFragment). Transparent
             Material theme; finishes when the sheet is dismissed. -->
        <activity
            android:name=".cloudstream.CloudStreamSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.CloudStreamSettings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Invisible AppCompatActivity used only to (re)load CloudStream plugins
             that cast their load context to AppCompatActivity (our main screen is a
             FlutterActivity). Transparent, no history, hidden from recents. -->
        <activity
            android:name=".cloudstream.CsPluginLoaderActivity"
            android:exported="false"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CloudStreamSettings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Hosts an Aniyomi extension's ConfigurableAnimeSource settings UI via a
             PreferenceFragmentCompat. Launched by AniyomiBridge.openSourceSettings. -->
        <activity
            android:name=".aniyomi.AniyomiSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.AniyomiSettings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Hosts a Mihon extension's ConfigurableSource settings UI via a
             PreferenceFragmentCompat. Launched by MihonBridge.openSourceSettings. -->
        <activity
            android:name=".mihon.MihonSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.MihonSettings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Visible WebView to solve a source's Cloudflare (interactive Turnstile)
             challenge; cf_clearance lands in the shared CookieManager the Mihon
             OkHttp client reads. -->
        <activity
            android:name=".mihon.SourceWebViewActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.MihonSettings"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Fully-native TV video player (TvPlayerActivity). Landscape, no title
             bar; renders ExoPlayer's SurfaceView straight to the window so TVs
             that black-screen the Flutter platform-view player show video. -->
        <activity
            android:name=".TvPlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <!-- Native phone video player (PhonePlayerActivity). The phone's
            orientation preference controls its initial layout and rotation.
            This is scoped to this Activity; TV keeps its fixed orientation.
            supportsPictureInPicture lets the player shrink to a floating
            window; the Activity enters it itself (PipController) on the PiP
            control or automatically when the user leaves the app. -->
        <activity
            android:name=".PhonePlayerActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:theme="@style/Theme.PhonePlayer" />
        <!-- Keeps the native phone player's audio running (and its media
            notification alive) while the app is backgrounded or the player is
            in PiP. mediaPlayback type so Android 14+ accepts it for playback. -->
        <service
            android:name=".PhonePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Google Cast Framework configuration. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.spyou.watch_app.cast.CastOptionsProvider" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- No Impeller flag on purpose. Built on Flutter 3.41.x, whose default
             renderer this device handles (1.8.0 shipped with no flag and worked).
             Forcing EnableImpeller=false here black-screened it, so we match
             1.8.0 exactly and leave the default. mpv gpu-next video is separate. -->

        <!-- Lets an external player read a DOWNLOADED episode. A download
             arrives as a bare filesystem path, which is a URI with no scheme
             at all: lenient players guess it is a file, a strict one resolves
             nothing and the launch fails. Android 7+ refuses a file:// handed
             to another app, so content:// is the only form left. Used ONLY as
             a fallback after a direct launch finds no activity, so every
             launch that works today is untouched. -->
        <!-- Daily picks: flutter_local_notifications' own receivers, which the
             plugin no longer declares itself (v16+). ScheduledNotificationReceiver
             posts a due alarm; ScheduledNotificationBootReceiver re-arms the
             daily alarms after a reboot or an app update. Without these the
             zonedSchedule calls are accepted and then silently never fire. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Bandwidth sharing: restart the peer SDK after a reboot or update,
             but only when the user opted in (see PeerShareBootReceiver). The
             action list must match PeerShareBootReceiver.ACTIONS exactly: a
             filter with an action the receiver ignores is dead weight, and one
             the receiver handles but the filter omits never arrives. -->
        <receiver
            android:exported="false"
            android:name=".bandwidth.PeerShareBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Fires the alarm that PeerShareRestart schedules at boot for builds
             targeting Android 15+, which may not start a dataSync service
             straight from BOOT_COMPLETED. Internal: same-app PendingIntent only. -->
        <receiver
            android:exported="false"
            android:name=".bandwidth.PeerShareRestartReceiver" />
        <!-- The peer SDK is vendored as source (android/app/src/main/kotlin/sx/proxies/peer)
             so its notification copy is ours; an AAR would have merged this same
             declaration, so it moves here with the source.

             `specialUse`, not `dataSync`: a dataSync service cannot be started
             from BOOT_COMPLETED on Android 15+ and is stopped after 6h in any
             24h window, so it could never be the always-on sharing service this
             feature needs. specialUse has neither limit; the subtype property is
             what Android asks for to justify the type. -->
        <service
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:name="sx.proxies.peer.service.PeerProxyService">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="peer-to-peer bandwidth sharing while the user is opted in" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.videoprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/video_paths" />
        </provider>
        <!-- Receives repo links (https://…json, stremio:) from a browser or
             another app and hands them to the add-repo flow. Finishes itself. -->
        <activity
            android:name=".parity.RepoLinkActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stremio" />
                <data android:scheme="https" android:host="*" android:pathPattern=".*\\.json" />
                <data android:scheme="http" android:host="*" android:pathPattern=".*\\.json" />
            </intent-filter>
        </activity>
        <service
            android:name=".parity.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- AI Dub binds the system TextToSpeech engine. Android 11+ hides
             packages an app has not declared, and an unbound engine reports
             itself as missing rather than failing loudly. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Any installed app that can open a video, so the external-player
             picker isn't limited to the handful we know by name below. Without
             this, Android 11+ hides them and the picker silently under-reports.
             Both mimes: plain files resolve as video/*, HLS as x-mpegURL. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="video/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/x-mpegURL"/>
        </intent>
        <!-- External video players we send tailored extras to (headers, subs,
             resume position). Listed by name as well as by the intents above:
             the mime queries alone don't reach a player whose filter doesn't
             advertise these exact types, and these are the ones that must
             always resolve. -->
        <package android:name="com.mxtech.videoplayer.ad"/>
        <package android:name="com.mxtech.videoplayer.pro"/>
        <package android:name="org.videolan.vlc"/>
        <package android:name="is.xyz.mpv"/>
        <package android:name="com.brouken.player"/>
        <package android:name="dev.anilbeesetti.nextplayer"/>
        <!-- SPlayer ships under two ids; both were in knownPlayers but missing
             here, so getPackageInfo threw and it never showed up. -->
        <package android:name="com.young.simple.player"/>
        <package android:name="com.ttee.leeplayer"/>
        <!-- UPI apps — the donate screen deep-links upi://pay. Needed for
             url_launcher to resolve an installed UPI app on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
        <!-- System speech recogniser — TV voice search resolves this intent
             (package visibility on Android 11+). -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
